FROM node:24-bookworm-slim AS builder

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV WRANGLER_LOG_PATH=/tmp/wrangler.log

COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/dist /app/dist
COPY --from=builder /app/drizzle /app/drizzle
COPY --from=builder /app/deploy/local /app/deploy/local

RUN mkdir -p /data && chown -R node:node /app /data
USER node
EXPOSE 8080
WORKDIR /app/dist/server

CMD ["/app/node_modules/.bin/wrangler", "dev", "--config", "wrangler.json", "--ip", "0.0.0.0", "--port", "8080", "--persist-to", "/data", "--local", "--log-level", "warn", "--show-interactive-dev-session=false"]
